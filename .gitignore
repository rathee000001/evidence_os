# EvidenceOS external evidence vault safety
evidence_os_evidence_vault/
../evidence_os_evidence_vault/
D:/evidence_os_evidence_vault/
D:\evidence_os_evidence_vault\

# Raw evidence files should not be committed to app repo
*.pdf
*.docx
*.xlsx
*.xls
*.csv
*.twb
*.twbx
*.hyper
*.zip
*.7z
*.rar

# Raw images/screenshots should stay in evidence vault unless explicitly approved into public assets
*.png
*.jpg
*.jpeg
*.webp
*.avif

